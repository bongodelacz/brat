ADMIN_PASSWORD="ZmienToNaMocneHaslo123"
ADMIN_USERNAME="Admin"

# --- Domeny / CORS (po deployu frontu wpisz dokładny URL z Vercela) ---
CORS_ORIGINS="http://localhost:3000,https://twoj-front.vercel.app"
PUBLIC_APP_URL="https://twoj-front.vercel.app"

# Lokalnie po HTTP ustaw false, na produkcji (HTTPS) true.
COOKIE_SECURE="false"

# --- 2FA / e-mail (Resend: https://resend.com) ---
# Jeśli NIE masz jeszcze klucza Resend, zostaw REQUIRE_ADMIN_2FA=false,
# wtedy admin loguje się samym hasłem. Gdy dodasz RESEND_API_KEY, ustaw na true.
REQUIRE_ADMIN_2FA="false"
RESEND_API_KEY=""
EMAIL_FROM="BratClient <onboarding@resend.dev>"
EMAIL_FROM_NAME="BratClient"
